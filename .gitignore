# .gitignore for Aawaaj

# Backend (Go)
backend/.env
backend/aawaaj-api
backend/*.exe
backend/*.dll
backend/*.so
backend/*.dylib
backend/*.test
backend/*.out
backend/vendor/

# Frontend (React/Vite)
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.production
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/

# Testing
coverage/
*.cover
*.test

# Temporary files
tmp/
temp/
*.tmp

# Build artifacts
build/
out/

# OS files
Thumbs.db
.DS_Store
