# Aawaaj Frontend Environment Variables

# ============================================
# API CONFIGURATION
# ============================================

# API Base URL (Backend server)
# Development: http://localhost:8080/api/v1
# Production: https://api.aawaaz.com/api/v1
VITE_API_URL=http://localhost:8080/api/v1

# Application Mode (development or production)
# Affects logging behavior in API service
# Development: Full request/response logging
# Production: Error logging only
VITE_MODE=development

# ============================================
# APP CONFIGURATION
# ============================================

VITE_APP_NAME=Aawaaz
VITE_APP_VERSION=2.0.0

# ============================================
# FEATURE FLAGS
# ============================================

# Enable analytics tracking
VITE_ENABLE_ANALYTICS=false

# Enable API request/response logging (development mode only)
# This is automatically handled by VITE_MODE, but can be overridden
VITE_ENABLE_LOGGING=true

# ============================================
# ADVANCED SETTINGS (Optional)
# ============================================

# API request timeout in milliseconds
# Default: 30000 (30 seconds)
# VITE_API_TIMEOUT=30000

# Maximum file upload size in MB
# VITE_MAX_UPLOAD_SIZE=10

